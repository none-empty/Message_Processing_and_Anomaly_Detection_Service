# Copy to .env. Docker Compose reads these values and passes them to the containers.
# MongoDB and SignalR use this stack's service names and container ports.
MongoDB__ConnectionString=mongodb://mongodb:27017
MongoDB__DataBaseName=server_statistics
MongoDB__CollectionName=statistics
SignalR__Url=http://datahub:8080/alerts
SignalR__RemoteProcedureName=SendAlert

# RabbitMQ is hosted by ServerStatisticsCollectionService on its messaging network.
RABBITMQ_NETWORK=serverstatisticscollectionservice_messaging
RabbitMQ__HostName=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__UserName=guest
RabbitMQ__Password=guest
RabbitMQ__BufferCapacity=256
RabbitMQ__PrefetchCount=32

# DataHub's port for clients outside the Compose network.
DATAHUB_PORT=5198

# Set the evaluation thresholds for your workload. Zero matches the existing defaults.
MemoryUsageAnomalyThresholdPercentage=0
MemoryUsageThresholdPercentage=0
CpuUsageAnomalyThresholdPercentage=0
CpuUsageThresholdPercentage=0
